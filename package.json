{
  "name": "image-extractor-extension",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "node scripts/check-background.mjs",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "wxt": "^0.21.4"
  },
  "license": "MIT",
  "description": "Chrome extension to extract webpage images, resolve original URLs from supported thumbnails, and download ZIPs. Supports batch URLs, local HTML, failed-only retries, cache-based recovery, and English/Chinese UI."
}
